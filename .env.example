# Docker Compose (banco dentro do container)
POSTGRES_USER=billwatch
POSTGRES_PASSWORD=

# Backend rodando fora do Docker contra um Postgres local
DB_USER=postgres
DB_PASSWORD=

# Chave HS256 em base64: gere com `openssl rand -base64 48`
JWT_SECRET=

# Atrás de proxy/balanceador em produção, use "native" para o rate limit ver o IP real do cliente.
# Só ligue se a porta do backend NÃO estiver exposta diretamente (veja o README).
FORWARD_HEADERS_STRATEGY=none

# Endereço público do frontend (links dos e-mails) e origens liberadas no CORS (separadas por vírgula).
APP_URL_FRONTEND=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# E-mail. Em desenvolvimento o Mailpit dispensa usuário e senha.
# Em produção, use um SMTP real; por exemplo: MAIL_PORT=587, MAIL_SMTP_AUTH=true, MAIL_STARTTLS=true.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=BillWatch <nao-responda@billwatch.local>

# Login com Google: Client ID do tipo "Aplicativo da Web" criado no Google Cloud Console.
# Vazio desliga o login com Google.
GOOGLE_CLIENT_ID=
